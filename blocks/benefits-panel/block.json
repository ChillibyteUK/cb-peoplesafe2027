{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-peoplesafe2027/benefits-panel",
	"title": "Benefits panel",
	"category": "cb-peoplesafe2027",
	"description": "A tinted panel with a title and introduction over a mosaic of benefit cards (icon, title, text) and photos. Each tile sets how wide it is, and a card can sit under the one before it. An optional footnote sits under the tiles.",
	"icon": "grid-view",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"intro": { "type": "string", "default": "" },
		"footnote": { "type": "string", "default": "" },
		"items": {
			"type": "array",
			"default": [
				{ "type": "card", "image": 0, "imageUrl": "", "title": "", "content": "", "span": 3, "offset": 0, "stack": false }
			]
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"color": {
			"background": true,
			"text": false,
			"link": false,
			"gradients": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
