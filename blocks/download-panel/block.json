{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-peoplesafe2027/download-panel",
	"title": "Download panel",
	"category": "cb-peoplesafe2027",
	"description": "A file upload that shows as one button: pick the file and type the button text.",
	"icon": "download",
	"attributes": {
		"file": { "type": "number", "default": 0 },
		"fileName": { "type": "string", "default": "" },
		"buttonLabel": { "type": "string", "default": "" }
	},
	"supports": { "anchor": true, "className": true },
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
