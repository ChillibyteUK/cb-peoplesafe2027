{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-peoplesafe2027/feature-list",
	"title": "Feature list",
	"category": "cb-peoplesafe2027",
	"description": "A title over a checklist of terms, each with a short definition, in two columns on desktop.",
	"icon": "yes-alt",
	"attributes": {
		"preTitle": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"tickColour": { "type": "string", "default": "" },
		"items": {
			"type": "array",
			"default": [
				{ "term": "", "definition": "" },
				{ "term": "", "definition": "" }
			]
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"color": {
			"background": true,
			"text": false,
			"link": false,
			"gradients": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
