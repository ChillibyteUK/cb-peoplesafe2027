{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-peoplesafe2027/embed",
	"title": "Embed",
	"category": "cb-peoplesafe2027",
	"description": "A Turtl document (paste its embed code) or a PDF shown on the page, with an optional title.",
	"icon": "media-document",
	"attributes": {
		"kind": { "type": "string", "default": "turtl" },
		"title": { "type": "string", "default": "" },
		"code": { "type": "string", "default": "" },
		"file": { "type": "number", "default": 0 },
		"fileName": { "type": "string", "default": "" }
	},
	"supports": {
		"anchor": true,
		"className": true,
		"color": { "background": true, "text": false, "link": false, "gradients": false }
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
