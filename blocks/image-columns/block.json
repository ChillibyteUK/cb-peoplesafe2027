{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-peoplesafe2027/image-columns",
	"title": "Image columns",
	"category": "cb-peoplesafe2027",
	"description": "Two to five images side by side, each with a bold title and text below it: centred on the page, or left-aligned on a yellow card. Put an ordinary heading and paragraph above it for the title and introduction.",
