	"attributes": {
		"style": { "type": "string", "default": "plain" },
		"items": {
			"type": "array",
			"default": [
				{ "image": 0, "imageUrl": "", "title": "", "text": "" },
				{ "image": 0, "imageUrl": "", "title": "", "text": "" },
				{ "image": 0, "imageUrl": "", "title": "", "text": "" }
			]
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"color": {
			"background": true,
			"text": false,
			"link": false,
			"gradients": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
