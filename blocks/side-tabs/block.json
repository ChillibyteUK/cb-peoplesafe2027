				{ "title": "", "content": "", "list": "", "linkText": "", "link": "", "linkTarget": false, "image": 0, "imageUrl": "" },
				{ "title": "", "content": "", "list": "", "linkText": "", "link": "", "linkTarget": false, "image": 0, "imageUrl": "" }
			]
