{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-peoplesafe2027/hero",
	"title": "Hero",
	"category": "cb-peoplesafe2027",
	"description": "The page hero: breadcrumbs, title, intro and buttons, with an image beside them. The title and image default to the page's own title and featured image.",
	"icon": "cover-image",
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"title": { "type": "string", "default": "" },
		"hideTitle": { "type": "boolean", "default": false },
		"intro": { "type": "string", "default": "" },
		"buttons": { "type": "array", "default": [] },
		"imageId": { "type": "number", "default": 0 },
		"imageUrl": { "type": "string", "default": "" },
		"hideBreadcrumbs": { "type": "boolean", "default": false }
	},
	"usesContext": [ "postId" ],
	"supports": {
		"anchor": true,
		"className": true
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
