{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-peoplesafe2027/form",
	"title": "Form",
	"category": "cb-peoplesafe2027",
	"description": "A Pardot form shown on the page, with an optional title and introduction. Leave the form address empty to use the Book a Demo form.",
	"icon": "feedback",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"intro": { "type": "string", "default": "" },
		"formUrl": { "type": "string", "default": "" },
		"height": { "type": "number", "default": 1200 }
	},
	"supports": {
		"anchor": true,
		"className": true,
		"color": {
			"background": true,
			"text": false,
			"link": false,
			"gradients": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
