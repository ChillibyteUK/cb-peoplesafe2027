{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-peoplesafe2027/logo-slider",
	"title": "Logo slider",
	"category": "cb-peoplesafe2027",
	"description": "A row of client logos that rotates when there are more than fit across, with an optional button to the case studies.",
	"icon": "images-alt2",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"logos": { "type": "array", "default": [] },
		"autoplay": { "type": "boolean", "default": true },
		"caseStudies": { "type": "string", "default": "" }
	},
	"supports": {
		"anchor": true,
		"className": true
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
